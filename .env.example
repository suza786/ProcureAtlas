DATABASE_URL=file:./db/custom.db
UPLOAD_DIR=./uploads
# Keep artifacts on private durable volumes outside public/.
EXPORT_DIR=./.private/exports
# ClamAV executable with current definitions; absent/failed scans remain quarantined.
CLAMAV_COMMAND=clamscan
# Account credentials and queued email payloads use a base64-encoded random 32-byte AES key.
APP_ENCRYPTION_KEY=
APP_ORIGIN=https://your-procureatlas-domain.example
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
# Show demo credentials only when intentionally building a demo frontend.
NEXT_PUBLIC_DEMO_MODE=false
# NEVER enable in production — grants unauthenticated owner access to the demo tenant
DEMO_MODE=false
DEMO_BILLING_SWITCHING=false
# Signed Stripe snapshot events; bind stripeCustomerId through trusted server administration.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLANS={}
# Inbound sources must sign requests; keep real source secrets in the deployment secret store.
# Format: {"worldbank":"<random-secret>","adb":"<random-secret>","custom":"<random-secret>"}
INBOUND_WEBHOOK_SECRETS={}
# Each signed inbound source is bound server-side to exactly one tenant ID.
INBOUND_WEBHOOK_TENANTS={}
# Enable only behind a proxy that overwrites client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false
# Seeding uses this explicit target, never DATABASE_URL. Set an absolute demo.db path in your shell.
# SEED_DEMO_DATABASE_URL=file:E:/sandbox/demo.db
