// ProcureAtlas AI — OCDS-inspired Prisma schema
// Phase 5: Public API Marketplace, MCP Production, Embeddings, Inbound Webhooks, Data Export.
// Dev: SQLite. Schema is PostgreSQL-ready (no SQLite-only types used in app-level fields).
// Multi-tenancy: every tenant-scoped model has tenantId + service-layer enforcement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identity & Tenancy
// ============================================================

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("free") // free | solo | professional | bid_team | enterprise | intelligence | pursuit_pro | team
  region      String   @default("BD")   // BD | SG | WB | ADB | UN | EU | US | GLOBAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  companies   Company[]
  pursuits    Pursuit[]
  alerts      Alert[]
  auditLogs   AuditLog[]
  fileUploads FileUpload[]
  llmExtractions LlmExtraction[]
  notifications Notification[]
  partnerSuggestions PartnerSuggestion[]
  subscription Subscription?
  proposals Proposal[]
  approvalChains ApprovalChain[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  notificationPreferences NotificationPreference[]
  currencyRates CurrencyRate[]
  bidCostEstimates BidCostEstimate[]
}

model User {
  id            String   @id @default(cuid())
  tenantId      String
  email         String   @unique
  name          String?
  role          String   @default("viewer") // owner | admin | manager | contributor | viewer
  passwordHash  String?  // Phase 2: bcrypt hash for credentials auth; null for SSO-only users
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?  // Phase 2+: TOTP secret (encrypted at rest in prod)
  mfaBackupCodes String? // Phase 2+: hashed backup codes (JSON array)
  failedLoginCount Int   @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]
  approvals     Approval[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  llmExtractionsRequested LlmExtraction[] @relation("LlmExtractionRequestedBy")
  llmExtractionsReviewed  LlmExtraction[] @relation("LlmExtractionReviewedBy")
  fileUploads   FileUpload[]

  @@index([tenantId])
}

// Phase 2: Session management (NextAuth-compatible shape, simplified)
model Session {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique
  expiresAt     DateTime
  ipHash        String?
  userAgent     String?
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// Canonical Procurement Model (OCDS-inspired)
// ============================================================

model Organization {
  id            String   @id @default(cuid())
  externalId    String?  // ID in source portal
  sourcePortal  String   // e.g. cptu_bd | gebiz_sg | worldbank | adb | ungm | ted | sam_gov
  name          String
  country       String?
  city          String?
  website       String?
  orgType       String   @default("buyer") // buyer | supplier | authority | partner | oem
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buyers        Buyer[]
  authorities   ProcurementAuthority[]
  awards        Award[]   @relation("AwardSupplier")
  tendersAsSupplier Tender[] @relation("TenderSupplier")
  buyerProfile  BuyerProfile?
  supplierProfile SupplierProfile?
  partnerSuggestions PartnerSuggestion[]

  @@unique([sourcePortal, externalId])
  @@index([sourcePortal])
  @@index([orgType])
}

model Buyer {
  id            String   @id @default(cuid())
  organizationId String
  department    String?
  createdAt     DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  tenders       Tender[]
}

model ProcurementAuthority {
  id            String   @id @default(cuid())
  organizationId String
  regulatoryScope String? // e.g. national | state | sector
  createdAt     DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
}

model Tender {
  id              String   @id @default(cuid())
  externalId      String?  // ID in source portal
  sourcePortal    String   // cptu_bd | gebiz_sg | worldbank | adb | ungm | ted | sam_gov
  sourceUrl       String
  title           String
  titleLocal      String?  // original-language title preserved
  description     String?
  country         String
  market          String   // BD | SG | WB | ADB | UN | EU | US
  sector          String   // IT | Cyber | Construction | Health | Consulting | Engineering | Goods | Services
  procurementMethod String? // open | selective | limited | direct
  noticeType      String?  // tender | rfp | rfq | eoi | prequalification
  currency        String   @default("USD")
  estimatedValue  Float?
  valueUSD        Float?
  publishedAt     DateTime?
  submissionDeadline DateTime?
  questionDeadline DateTime?
  bidValidityDays Int?
  tenderSecurityPct Float? // % of contract value
  performanceSecurityPct Float?
  status          String   @default("active") // active | closed | awarded | cancelled | amended
  awardStatus     String?  // pending | awarded | cancelled
  contactPerson   String?
  contactEmail    String?
  preBidMeetingAt DateTime?
  siteVisitAt     DateTime?
  rawJson         String?  // raw payload from source for traceability
  extractedAt     DateTime @default(now())
  confidence      Float    @default(0.8) // extraction confidence 0-1
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyerId         String?
  buyer           Buyer?   @relation(fields: [buyerId], references: [id])
  supplierOrgId   String?
  supplierOrg     Organization? @relation("TenderSupplier", fields: [supplierOrgId], references: [id])
  lots            Lot[]
  requirements    Requirement[]
  documents       TenderDocument[]
  amendments      Amendment[]
  awards          Award[]
  pursuits        Pursuit[]
  alerts          Alert[]
  llmExtractions  LlmExtraction[]

  @@unique([sourcePortal, externalId])
  @@index([sourcePortal])
  @@index([market])
  @@index([sector])
  @@index([status])
  @@index([submissionDeadline])
}

model Lot {
  id          String   @id @default(cuid())
  tenderId    String
  externalId  String?
  title       String
  description String?
  quantity    Float?
  unit        String?
  estimatedValue Float?
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirements Requirement[]

  @@index([tenderId])
}

model Requirement {
  id            String   @id @default(cuid())
  tenderId      String
  lotId         String?
  category      String   // eligibility | technical | financial | legal | experience | certification | document
  criterion     String   // e.g. "Minimum annual turnover"
  operator      String?  // >= | <= | == | contains | mandatory
  threshold     String?  // e.g. "5000000 USD"
  description   String?
  isMandatory   Boolean  @default(true)
  sourceDoc     String?  // document name where requirement was extracted from
  sourcePage    Int?
  sourceClause  String?
  extractedText String?
  confidence    Float    @default(0.85)
  createdAt     DateTime @default(now())

  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  lot           Lot?     @relation(fields: [lotId], references: [id])
  complianceItems ComplianceItem[]

  @@index([tenderId])
  @@index([category])
}

model TenderDocument {
  id            String   @id @default(cuid())
  tenderId      String
  name          String
  docType       String?  // notice | specification | addendum | drawing | form | boq
  sourceUrl     String?
  fileSizeKb    Int?
  checksum      String?
  uploadedAt    DateTime?
  createdAt     DateTime @default(now())

  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

model Amendment {
  id            String   @id @default(cuid())
  tenderId      String
  amendmentNo   Int
  title         String
  description   String
  publishedAt   DateTime
  affectsDeadline Boolean @default(false)
  affectsScope  Boolean  @default(false)
  newDeadline   DateTime?
  sourceUrl     String?
  createdAt     DateTime @default(now())

  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

model Award {
  id            String   @id @default(cuid())
  tenderId      String
  supplierOrgId String
  contractValue Float?
  currency      String   @default("USD")
  awardedAt     DateTime
  contractNo    String?
  sourceUrl     String?
  createdAt     DateTime @default(now())

  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplier      Organization @relation("AwardSupplier", fields: [supplierOrgId], references: [id])

  @@index([tenderId])
  @@index([supplierOrgId])
}

// ============================================================
// Company Brain (tenant-owned evidence)
// ============================================================

model Company {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  legalName     String?
  country       String
  city          String?
  registrationNo String?
  taxId         String?
  website       String?
  foundedYear   Int?
  employeeCount Int?
  annualTurnoverUSD Float?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence      Evidence[]
  certifications Certification[]
  projectRefs   ProjectReference[]
  employees     Employee[]
  pursuits      Pursuit[]

  @@index([tenantId])
}

model Evidence {
  id            String   @id @default(cuid())
  companyId     String
  category      String   // registration | financial | certification | project | oem | partnership | employee | facility | equipment | catalogue | reference | proposal_library | past_response | past_win | past_loss
  title         String
  description   String?
  issuer        String?  // who issued the evidence
  issuedAt      DateTime?
  expiresAt     DateTime?
  docUrl        String?
  checksum      String?
  verified      Boolean  @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  confidence    Float    @default(0.9)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complianceItems ComplianceItem[]
  fileUploads   FileUpload[]

  @@index([companyId])
  @@index([category])
  @@index([expiresAt])
}

model Certification {
  id            String   @id @default(cuid())
  companyId     String
  name          String   // ISO 27001 | ISO 9001 | CMMI L3 | SOC 2 | Cisco Gold | Microsoft AOSP
  standard      String?
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  certificateNo String?
  docUrl        String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
}

model ProjectReference {
  id            String   @id @default(cuid())
  companyId     String
  title         String
  client        String
  clientType    String?  // government | private | multilateral | ngo
  country       String?
  valueUSD      Float?
  startDate     DateTime?
  endDate       DateTime?
  role          String?  // prime | subcontractor | consortium | oem | implementer
  description   String?
  evidenceUrl   String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientType])
}

model Employee {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  role          String?
  qualifications String? // comma-separated certifications
  yearsExperience Int?
  securityClearance String?
  cvUrl         String?
  createdAt     DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ============================================================
// Pursuits & Bids
// ============================================================

model Pursuit {
  id            String   @id @default(cuid())
  tenantId      String
  tenderId      String
  companyId     String
  stage         String   @default("discovering") // discovering | qualifying | bidding | submitted | won | lost | no_bid
  bidDecision   String?  // bid | no_bid | pending
  decisionReason String?
  decisionBy    String?
  decidedAt     DateTime?
  ownerId       String?
  priority      String   @default("medium") // low | medium | high | strategic
  estimatedValueUSD Float?
  winProbability Float?  // 0-1 (separate from deterministic scores; for forecasting only)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tender        Tender   @relation(fields: [tenderId], references: [id])
  company       Company  @relation(fields: [companyId], references: [id])
  bid           Bid?
  complianceItems ComplianceItem[]
  tasks         Task[]
  approvals     Approval[]
  proposals     Proposal[]
  bidCostEstimates BidCostEstimate[]

  @@index([tenantId])
  @@index([stage])
  @@index([companyId])
}

model Bid {
  id            String   @id @default(cuid())
  pursuitId     String   @unique
  status        String   @default("draft") // draft | in_review | approved | submitted | withdrawn
  technicalScore Float?
  commercialScore Float?
  totalScore    Float?
  submissionReady Boolean @default(false)
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pursuit       Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  tasks         Task[]

  @@index([pursuitId])
}

model ComplianceItem {
  id            String   @id @default(cuid())
  pursuitId     String
  requirementId String
  evidenceId    String?
  status        String   @default("gap") // compliant | partial | gap | not_applicable
  notes         String?
  evidenceText  String?  // extracted snippet from evidence doc
  confidence    Float    @default(0)
  owner         String?
  dueAt         DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pursuit       Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  evidence      Evidence? @relation(fields: [evidenceId], references: [id])

  @@index([pursuitId])
  @@index([status])
}

model Task {
  id            String   @id @default(cuid())
  pursuitId     String
  bidId         String?
  title         String
  description   String?
  assignee      String?
  status        String   @default("todo") // todo | in_progress | in_review | done | blocked
  priority      String   @default("medium")
  dueAt         DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pursuit       Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  bid           Bid?     @relation(fields: [bidId], references: [id])

  @@index([pursuitId])
  @@index([status])
}

model Approval {
  id            String   @id @default(cuid())
  tenantId      String
  pursuitId     String
  proposalId    String?
  chainId       String?
  triggerType   String   @default("bid_decision") // bid_decision | submission | pricing | legal | evidence_verification
  stepOrder     Int      @default(0)
  requestedBy   String
  approverId    String?
  approverRole  String?  // required role for this step
  decision      String   @default("pending") // pending | approved | rejected | changes_requested
  reason        String?
  slaDueAt      DateTime?
  decidedAt     DateTime?
  escalatedAt   DateTime?
  createdAt     DateTime @default(now())

  pursuit       Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  approver      User?    @relation(fields: [approverId], references: [id])
  proposal      Proposal? @relation(fields: [proposalId], references: [id])

  @@index([pursuitId])
  @@index([proposalId])
  @@index([decision])
  @@index([triggerType])
}

// ============================================================
// Alerts & Outcomes
// ============================================================

model Alert {
  id            String   @id @default(cuid())
  tenantId      String
  tenderId      String?
  type          String   // deadline | amendment | new_opportunity | eligibility_gap | evidence_expiry | award
  severity      String   @default("medium") // low | medium | high | critical
  title         String
  message       String
  dueAt         DateTime?
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tender        Tender?  @relation(fields: [tenderId], references: [id])

  @@index([tenantId])
  @@index([severity])
}

model Outcome {
  id            String   @id @default(cuid())
  pursuitId     String   @unique
  result        String   // won | lost | withdrawn | disqualified | no_decision
  awardValueUSD Float?
  lossReason    String?
  lessonsLearned String?
  recordedAt    DateTime @default(now())
}

// ============================================================
// Data Source Registry & Audit
// ============================================================

model DataSource {
  id            String   @id @default(cuid())
  code          String   @unique // cptu_bd | gebiz_sg | worldbank | adb | ungm | ted | sam_gov
  name          String
  country       String
  url           String
  accessMethod  String   // official_api | public_feed | rss | open_data | permitted_pages | user_upload
  legalStatus   String   @default("verified") // verified | under_review | prohibited
  lastReviewedAt DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?
  action        String
  entityType    String
  entityId      String?
  beforeJson    String?
  afterJson     String?
  ipHash        String?
  userAgent     String?
  // Phase 2: LLM-specific audit fields
  llmModel      String?
  llmPromptHash String?
  llmInputTokens Int?
  llmOutputTokens Int?
  llmLatencyMs  Int?
  llmCostUsd    Float?
  requestId     String?
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ============================================================
// Phase 2: File Uploads (evidence + tender documents)
// ============================================================

model FileUpload {
  id            String   @id @default(cuid())
  tenantId      String
  uploadedById  String?
  fileName      String
  fileType     String   // mime type
  fileSizeKb    Int
  checksum      String   // sha256
  storageKey    String   // path under tenant-scoped prefix; e.g. {tenantId}/evidence/{fileId}
  storageUrl    String?  // signed URL or local path (dev)
  category      String   // evidence | tender_document | bid_document | proposal
  evidenceId    String?  // linked Evidence record (nullable until evidence is created)
  virusScanResult String? @default("pending") // pending | clean | infected | error
  textExtracted String?  // extracted text content (truncated to 64k for SQLite)
  textExtractedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  evidence      Evidence? @relation(fields: [evidenceId], references: [id])
  llmExtractions LlmExtraction[]

  @@index([tenantId])
  @@index([category])
  @@index([evidenceId])
}

// ============================================================
// Phase 2: LLM Extraction (evidence-gated, source-cited, human-reviewed)
// ============================================================

model LlmExtraction {
  id            String   @id @default(cuid())
  tenantId      String
  tenderId      String?
  fileUploadId  String?
  requestedById String?
  taskType      String   // requirement_extraction | tender_summary | classification | eligibility_narrative | translation
  status        String   @default("pending") // pending | completed | failed | needs_review | approved | rejected
  inputHash     String?  // hash of input text for caching
  promptHash    String?
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  costUsd       Float?
  outputJson    String?  // raw LLM output (validated against schema)
  extractedItemsJson String? // parsed items as JSON array
  reviewStatus  String   @default("pending") // pending | approved | rejected | edited
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tender        Tender?  @relation(fields: [tenderId], references: [id])
  fileUpload    FileUpload? @relation(fields: [fileUploadId], references: [id])
  requestedBy   User?    @relation("LlmExtractionRequestedBy", fields: [requestedById], references: [id])
  reviewedBy    User?    @relation("LlmExtractionReviewedBy", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([tenderId])
  @@index([status])
  @@index([reviewStatus])
}

// ============================================================
// Phase 2: Connector Run Logging (per-source ingestion audit)
// ============================================================

model ConnectorRun {
  id            String   @id @default(cuid())
  sourceCode    String   // cptu_bd | gebiz_sg | worldbank | ...
  runType       String   // scheduled | manual | backfill
  status        String   @default("running") // running | success | partial | failed
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  itemsFetched  Int      @default(0)
  itemsCreated  Int      @default(0)
  itemsUpdated  Int      @default(0)
  itemsSkipped  Int      @default(0)
  errorMessage  String?
  logJson       String?  // structured run log
  triggeredById String?

  @@index([sourceCode])
  @@index([status])
  @@index([startedAt])
}

// ============================================================
// Phase 2: API Keys (for MCP + public API marketplace)
// ============================================================

model ApiKey {
  id            String   @id @default(cuid())
  tenantId      String?  // null for platform-level keys
  userId        String?
  name          String
  keyPrefix     String   // first 8 chars of key for identification
  keyHash       String   // bcrypt hash of full key
  scopes        String   // space-separated: mcp:read | api:read | api:write
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([keyHash])
}

// ============================================================
// Phase 2: Notifications (in-app + email digest)
// ============================================================

model Notification {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?  // null = broadcast to tenant
  type          String   // alert | deadline | amendment | extraction_ready | approval_request | system
  title         String
  message       String
  link          String?  // relative path
  readAt        DateTime?
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([readAt])
}

// ============================================================
// Phase 3: Intelligence Layer — Buyer, Award, Competitor, Partner
// ============================================================

// Enriched buyer profile — aggregated from Awards + Tenders
model BuyerProfile {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  totalTendersPosted Int    @default(0)
  totalAwardValueUSD Float  @default(0)
  averageAwardValueUSD Float @default(0)
  topSuppliers    String?  // JSON array of {supplierId, name, awardCount, totalValue}
  preferredSectors String? // JSON array of sector codes with counts
  averageTenderValueUSD Float @default(0)
  incumbentCount  Int      @default(0) // distinct suppliers with >=1 award
  firstTenderAt   DateTime?
  lastTenderAt    DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Enriched supplier/competitor profile — aggregated from Awards
model SupplierProfile {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  totalAwards     Int      @default(0)
  totalAwardValueUSD Float  @default(0)
  averageAwardValueUSD Float @default(0)
  winRate         Float    @default(0) // estimated; awards / (awards + known losses)
  topBuyers       String?  // JSON array of {buyerId, name, awardCount, totalValue}
  sectorsWon      String?  // JSON array of sector codes with counts
  countriesWon    String?  // JSON array of country codes with counts
  firstAwardAt    DateTime?
  lastAwardAt     DateTime?
  isCompetitor    Boolean  @default(false) // flagged as competitor to current tenant
  isPartner       Boolean  @default(false) // flagged as potential partner
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isCompetitor])
  @@index([isPartner])
}

// Partner / JV suggestion — computed matching score
model PartnerSuggestion {
  id              String   @id @default(cuid())
  tenantId        String
  organizationId  String   // the suggested partner org
  matchScore      Float    // 0-1
  matchReasons    String?  // JSON array of {reason, weight}
  complementaryCapabilities String? // JSON array
  geographicOverlap String? // JSON array of overlapping markets
  priorJVHistory  Boolean  @default(false)
  status          String   @default("suggested") // suggested | contacted | engaged | rejected
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([organizationId])
  @@index([matchScore])
}

// ============================================================
// Phase 3: Billing — Subscriptions, Usage Metrics, Invoices
// ============================================================

model Subscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  plan            String   @default("free") // free | solo | professional | bid_team | enterprise | intelligence | pursuit_pro | team
  status          String   @default("active") // active | past_due | canceled | trialing
  billingCycle    String   @default("monthly") // monthly | yearly
  seatsIncluded   Int      @default(1)
  tendersTrackedLimit Int  @default(50)
  pursuitsLimit   Int      @default(5)
  apiCallsLimit   Int      @default(1000)
  llmTokensLimit  Int      @default(50000)
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  stripeCustomerId String?
  stripeSubscriptionId String?
  sslcommerzStoreId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  usageMetrics    UsageMetric[]

  @@index([tenantId])
}

model UsageMetric {
  id              String   @id @default(cuid())
  subscriptionId  String
  tenantId        String
  metricType      String   // api_calls | llm_tokens | tenders_tracked | pursuits | file_uploads
  periodStart     DateTime
  periodEnd       DateTime
  count           Int      @default(0)
  limit           Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, metricType, periodStart])
  @@index([tenantId])
  @@index([metricType])
}

model Invoice {
  id              String   @id @default(cuid())
  subscriptionId  String
  tenantId        String
  invoiceNumber   String   @unique
  amount          Float
  currency        String   @default("USD")
  status          String   @default("pending") // pending | paid | void | refunded
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  pdfUrl          String?
  lineItemsJson   String?  // JSON array of line items
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([status])
}

// ============================================================
// Phase 4: Proposal Studio — Proposals, Sections, Versions
// ============================================================

model Proposal {
  id              String   @id @default(cuid())
  tenantId        String
  pursuitId       String
  title           String
  status          String   @default("draft") // draft | in_review | approved | submitted | withdrawn
  currentVersion  Int      @default(1)
  totalSections   Int      @default(0)
  completedSections Int    @default(0)
  evidenceCoverage Float   @default(0) // 0-1 — % of sections with evidence backing
  wordCount       Int      @default(0)
  lastEditedAt    DateTime?
  lastEditedBy    String?
  submittedAt     DateTime?
  exportFormat    String?  // docx | pdf | null
  exportUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pursuit         Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  sections        ProposalSection[]
  versions        ProposalVersion[]
  approvals       Approval[]

  @@index([tenantId])
  @@index([pursuitId])
  @@index([status])
}

model ProposalSection {
  id              String   @id @default(cuid())
  proposalId      String
  sectionType     String   // executive_summary | technical_approach | methodology | team | past_performance | pricing | compliance | risk | timeline | appendix
  title           String
  content         String?  // markdown content
  wordCount       Int      @default(0)
  status          String   @default("todo") // todo | drafting | in_review | approved | needs_revision
  evidenceIds     String?  // JSON array of Evidence IDs backing this section
  evidenceCount   Int      @default(0)
  hasGaps         Boolean  @default(false) // true if section makes claims without evidence
  assignedTo      String?  // user email
  order           Int      @default(0)
  aiAssisted      Boolean  @default(false) // true if content was AI-drafted
  aiModel         String?
  lastEditedAt    DateTime?
  lastEditedBy    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([sectionType])
  @@index([status])
}

model ProposalVersion {
  id              String   @id @default(cuid())
  proposalId      String
  versionNumber   Int
  snapshotJson    String   // full snapshot of all sections at this version
  wordCount       Int
  sectionCount    Int
  changeSummary   String?
  createdBy       String?
  createdAt       DateTime @default(now())

  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([versionNumber])
}

// ============================================================
// Phase 4: Approval Workflows — Configurable chains
// ============================================================

model ApprovalChain {
  id              String   @id @default(cuid())
  tenantId        String
  name            String   // e.g. "Bid Submission Approval", "Pricing Approval"
  triggerType     String   // bid_decision | submission | pricing | legal | evidence_verification
  isActive        Boolean  @default(true)
  slaHours        Int      @default(48) // SLA for each step
  stepsJson       String?  // JSON array of {order, role, approverEmail, autoApprove}
  stepCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([triggerType])
  @@index([isActive])
}

// ============================================================
// Phase 4: Webhooks — Outbound event delivery
// ============================================================

model WebhookEndpoint {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  url             String
  secret          String   // HMAC signing secret (encrypted at rest in prod)
  events          String   // space-separated event types
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  lastResponseCode Int?
  lastSuccessAt   DateTime?
  consecutiveFailures Int  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([tenantId])
  @@index([isActive])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  endpointId      String
  eventType       String
  payloadJson     String   // the event payload
  signature       String   // HMAC-SHA256 signature
  status          String   @default("pending") // pending | delivered | failed | retrying
  attemptCount    Int      @default(0)
  maxAttempts     Int      @default(5)
  nextRetryAt     DateTime?
  responseCode    Int?
  responseBody    String?
  errorMessage    String?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([endpointId])
  @@index([status])
  @@index([nextRetryAt])
}

// ============================================================
// Phase 4: Notification Preferences
// ============================================================

model NotificationPreference {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  channel         String   // in_app | email | slack | teams
  eventType       String   // alert | deadline | amendment | extraction_ready | approval_request | system | webhook_delivery
  enabled         Boolean  @default(true)
  minSeverity     String   @default("low") // low | medium | high | critical
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, channel, eventType])
  @@index([tenantId])
  @@index([userId])
}

// ============================================================
// Phase 4: Multi-currency financial modeling
// ============================================================

model CurrencyRate {
  id              String   @id @default(cuid())
  tenantId        String
  baseCurrency    String   @default("USD")
  quoteCurrency   String   // BDT | SGD | EUR | GBP | INR | etc.
  rate            Float    // 1 base = rate quote
  source          String   @default("manual") // manual | ecb | openexchangerates
  rateDate        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, baseCurrency, quoteCurrency])
  @@index([tenantId])
}

model BidCostEstimate {
  id              String   @id @default(cuid())
  tenantId        String
  pursuitId       String
  label           String
  currency        String   @default("USD")
  laborCost       Float    @default(0)
  materialsCost   Float    @default(0)
  subcontractorCost Float   @default(0)
  overheadCost    Float    @default(0)
  travelCost      Float    @default(0)
  contingencyPct  Float    @default(10) // %
  totalCost       Float    @default(0)
  marginPct       Float    @default(20) // %
  proposedPrice   Float    @default(0)
  profitAmount    Float    @default(0)
  notes           String?
  hedgingNotes    String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pursuit         Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([pursuitId])
}

// ============================================================
// Phase 5: Public API Marketplace — Rate limiting, Embeddings, Inbound Webhooks, Data Export
// ============================================================

model RateLimitBucket {
  id              String   @id @default(cuid())
  tenantId        String?
  apiKeyId        String?
  identifier      String   // IP hash or API key prefix
  bucketKey       String   // e.g. "api:v1:tenders" or "mcp:tools/call"
  tokens          Float    @default(100) // token bucket model
  lastRefilledAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([identifier, bucketKey])
  @@index([apiKeyId])
  @@index([tenantId])
}

model Embedding {
  id              String   @id @default(cuid())
  tenantId        String?
  entityType      String   // tender | company | evidence | requirement
  entityId        String
  embeddingJson   String   // JSON array of floats (deterministic hash-based in dev; pgvector in prod)
  textHash        String   // hash of the source text for cache invalidation
  model           String   @default("deterministic-v1")
  dimensions      Int      @default(256)
  metadataJson    String?  // additional metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([tenantId])
  @@index([entityType])
}

model InboundWebhook {
  id              String   @id @default(cuid())
  tenantId        String?
  source          String   // worldbank | adb | ungm | external_crm | custom
  eventType       String
  signature       String?  // signature from source for verification
  signatureValid  Boolean  @default(false)
  payloadJson     String   // raw payload
  processedStatus String   @default("pending") // pending | processed | failed | ignored
  processedAt     DateTime?
  errorMessage    String?
  createdEntities String?  // JSON array of created entity IDs
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([source])
  @@index([processedStatus])
}

model DataExport {
  id              String   @id @default(cuid())
  tenantId        String
  requestedById   String?
  exportType      String   // tenders | pursuits | evidence | audit_log | full_backup | awards
  format          String   @default("json") // json | csv
  status          String   @default("pending") // pending | processing | completed | failed
  recordCount     Int      @default(0)
  fileSizeKb      Int      @default(0)
  downloadUrl     String?
  expiresAt       DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([tenantId])
  @@index([status])
}
